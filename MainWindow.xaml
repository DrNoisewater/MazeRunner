<Window x:Class="MazeRunner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MazeRunner.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:MazeRunner.Views"
        Title="MazeRunner"
        Width="1520"
        Height="930"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="VisualizerTemplate"><views:VisualizerView /></DataTemplate>
        <DataTemplate x:Key="CompareTemplate"><views:CompareView /></DataTemplate>
        <DataTemplate x:Key="HistoryTemplate"><views:HistoryView /></DataTemplate>
        <DataTemplate x:Key="SettingsTemplate"><views:SettingsView /></DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,5,6,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentMutedBrush}" BorderThickness="1" CornerRadius="7">
                        <TextBlock Text="M" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Margin="9,0,0,0" Text="MazeRunner" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Margin="10,0,0,0" Style="{StaticResource PillStyle}" Padding="7,2">
                        <TextBlock Text="ALGORITHM LAB" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="—" ToolTip="Minimize" Click="MinimizeButton_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}" Content="□" ToolTip="Maximize" Click="MaximizeButton_Click" />
                    <Button Style="{StaticResource CloseTitleBarButtonStyle}" Content="×" ToolTip="Close" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="14,7,14,12" Padding="14,12" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentSectionTitle}" Style="{StaticResource HeadingTextStyle}" />
                        <TextBlock Margin="0,3,0,0" Text="{Binding CurrentSectionDescription}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <ItemsControl Grid.Column="1" Margin="32,0,12,0" ItemsSource="{Binding NavigationItems}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,6,0"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Section}"
                                        Style="{StaticResource NavButtonStyle}"
                                        Tag="{Binding IsSelected}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="24" Height="24" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6">
                                            <TextBlock Text="{Binding ShortLabel}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Margin="7,0,0,0" Text="{Binding Title}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Column="2" Style="{StaticResource PillStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Margin="6,0,0,0" Text="Ready" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ContentControl x:Name="ContentHost" Grid.Row="2" Margin="14,0,14,12" Content="{Binding CurrentSection}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource VisualizerTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static models:AppSection.Compare}"><Setter Property="ContentTemplate" Value="{StaticResource CompareTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static models:AppSection.History}"><Setter Property="ContentTemplate" Value="{StaticResource HistoryTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static models:AppSection.Settings}"><Setter Property="ContentTemplate" Value="{StaticResource SettingsTemplate}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <Grid Grid.Row="3" Margin="15,0,15,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="MazeRunner · Randomized maze generation and pathfinding laboratory" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Ctrl+G generate · Ctrl+Enter solve · Space pause · F fit" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>

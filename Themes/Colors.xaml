<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#0B0F14</Color>
    <Color x:Key="SurfaceColor">#111821</Color>
    <Color x:Key="SurfaceAltColor">#151E29</Color>
    <Color x:Key="SurfaceRaisedColor">#1A2531</Color>
    <Color x:Key="BorderColor">#263442</Color>
    <Color x:Key="BorderStrongColor">#344657</Color>
    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="TextSecondaryColor">#AAB7C5</Color>
    <Color x:Key="TextMutedColor">#748295</Color>
    <Color x:Key="AccentColor">#D4A55D</Color>
    <Color x:Key="AccentHoverColor">#E0B36C</Color>
    <Color x:Key="AccentSoftColor">#302619</Color>
    <Color x:Key="AccentMutedColor">#8E6E3E</Color>
    <Color x:Key="SuccessColor">#65C18C</Color>
    <Color x:Key="InformationColor">#76A9F4</Color>
    <Color x:Key="WarningColor">#E4B96B</Color>
    <Color x:Key="DangerColor">#E17F7F</Color>
    <Color x:Key="MazeCanvasColor">#0D131B</Color>
    <Color x:Key="MazeCellColor">#101923</Color>
    <Color x:Key="MazeCellAlternateColor">#111B26</Color>
    <Color x:Key="MazeCellGridColor">#1B2A38</Color>
    <Color x:Key="MazeWallColor">#587089</Color>
    <Color x:Key="MazeStartCellColor">#18372D</Color>
    <Color x:Key="MazeGoalCellColor">#3B2228</Color>
    <Color x:Key="MazeStartMarkerColor">#79D19C</Color>
    <Color x:Key="MazeGoalMarkerColor">#EA8A8A</Color>
    <Color x:Key="MazeEndpointTextColor">#0B0F14</Color>
    <Color x:Key="MazeVisitedColor">#243342</Color>
    <Color x:Key="MazeFrontierColor">#315C84</Color>
    <Color x:Key="MazeExploredColor">#294B68</Color>
    <Color x:Key="MazeCurrentColor">#B58442</Color>
    <Color x:Key="MazeSolutionColor">#1D4B38</Color>
    <Color x:Key="MazeSolutionRouteColor">#71E39D</Color>
    <Color x:Key="MazeBacktrackColor">#333054</Color>
    <Color x:Key="MazeTerrainColor">#514425</Color>
    <Color x:Key="MazeTerrainHighColor">#653D2B</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMutedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="InformationBrush" Color="{StaticResource InformationColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="MazeCanvasBackgroundBrush" Color="{StaticResource MazeCanvasColor}" />
    <SolidColorBrush x:Key="MazeCellBrush" Color="{StaticResource MazeCellColor}" />
    <SolidColorBrush x:Key="MazeCellAlternateBrush" Color="{StaticResource MazeCellAlternateColor}" />
    <SolidColorBrush x:Key="MazeCellGridBrush" Color="{StaticResource MazeCellGridColor}" />
    <SolidColorBrush x:Key="MazeWallBrush" Color="{StaticResource MazeWallColor}" />
    <SolidColorBrush x:Key="MazeStartCellBrush" Color="{StaticResource MazeStartCellColor}" />
    <SolidColorBrush x:Key="MazeGoalCellBrush" Color="{StaticResource MazeGoalCellColor}" />
    <SolidColorBrush x:Key="MazeStartMarkerBrush" Color="{StaticResource MazeStartMarkerColor}" />
    <SolidColorBrush x:Key="MazeGoalMarkerBrush" Color="{StaticResource MazeGoalMarkerColor}" />
    <SolidColorBrush x:Key="MazeEndpointTextBrush" Color="{StaticResource MazeEndpointTextColor}" />
    <SolidColorBrush x:Key="MazeVisitedBrush" Color="{StaticResource MazeVisitedColor}" />
    <SolidColorBrush x:Key="MazeFrontierBrush" Color="{StaticResource MazeFrontierColor}" />
    <SolidColorBrush x:Key="MazeExploredBrush" Color="{StaticResource MazeExploredColor}" />
    <SolidColorBrush x:Key="MazeCurrentBrush" Color="{StaticResource MazeCurrentColor}" />
    <SolidColorBrush x:Key="MazeSolutionBrush" Color="{StaticResource MazeSolutionColor}" />
    <SolidColorBrush x:Key="MazeSolutionRouteBrush" Color="{StaticResource MazeSolutionRouteColor}" />
    <SolidColorBrush x:Key="MazeBacktrackBrush" Color="{StaticResource MazeBacktrackColor}" />
    <SolidColorBrush x:Key="MazeTerrainBrush" Color="{StaticResource MazeTerrainColor}" />
    <SolidColorBrush x:Key="MazeTerrainHighBrush" Color="{StaticResource MazeTerrainHighColor}" />
</ResourceDictionary>

<UserControl x:Class="MazeRunner.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SETTINGS" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Margin="0,6,0,0" Text="Personalize the MazeRunner workspace" Style="{StaticResource HeadingTextStyle}" />
                        <TextBlock Margin="0,4,0,0" Text="Changes are saved automatically in your local application-data folder." Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource PillStyle}" VerticalAlignment="Center"><TextBlock Text="AUTO-SAVE" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" /></Border>
                </Grid>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Margin="0,8,0,4" Text="Theme" Style="{StaticResource MutedTextStyle}" />
                            <ComboBox x:Name="ThemeComboBox" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="SettingChanged"><ComboBoxItem Content="Dark" /><ComboBoxItem Content="Light" /></ComboBox>
                            <TextBlock Margin="0,14,0,4" Text="Accent preset" Style="{StaticResource MutedTextStyle}" />
                            <ComboBox x:Name="AccentComboBox" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="SettingChanged"><ComboBoxItem Content="Amber" /><ComboBoxItem Content="Blue" /><ComboBoxItem Content="Green" /><ComboBoxItem Content="Purple" /></ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="CANVAS" Style="{StaticResource EyebrowTextStyle}" />
                            <CheckBox x:Name="ShowGridCheckBox" Margin="0,9,0,0" Content="Show cell grid" Style="{StaticResource ModernCheckBoxStyle}" Checked="SettingChanged" Unchecked="SettingChanged" />
                            <CheckBox x:Name="ShowMarkersCheckBox" Margin="0,9,0,0" Content="Show weighted-terrain labels" Style="{StaticResource ModernCheckBoxStyle}" Checked="SettingChanged" Unchecked="SettingChanged" />
                            <CheckBox x:Name="ReduceMotionCheckBox" Margin="0,9,0,0" Content="Reduce motion" Style="{StaticResource ModernCheckBoxStyle}" Checked="SettingChanged" Unchecked="SettingChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="DEFAULTS" Style="{StaticResource EyebrowTextStyle}" />
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="WIDTH" Style="{StaticResource MutedTextStyle}" /><TextBox x:Name="DefaultWidthTextBox" Margin="0,4,0,0" Style="{StaticResource ModernTextBoxStyle}" TextChanged="SettingTextChanged" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="HEIGHT" Style="{StaticResource MutedTextStyle}" /><TextBox x:Name="DefaultHeightTextBox" Margin="0,4,0,0" Style="{StaticResource ModernTextBoxStyle}" TextChanged="SettingTextChanged" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Animation speed" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="SpeedLabel" Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /></Grid>
                            <Slider x:Name="SpeedSlider" Margin="0,5,0,0" Minimum="1" Maximum="100" Style="{StaticResource ModernSliderStyle}" ValueChanged="SpeedSlider_ValueChanged" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="HISTORY" Style="{StaticResource EyebrowTextStyle}" />
                            <CheckBox x:Name="SaveHistoryCheckBox" Margin="0,9,0,0" Content="Save completed runs locally" Style="{StaticResource ModernCheckBoxStyle}" Checked="SettingChanged" Unchecked="SettingChanged" />
                            <CheckBox x:Name="ConfirmClearCheckBox" Margin="0,9,0,0" Content="Confirm before clearing history" Style="{StaticResource ModernCheckBoxStyle}" Checked="SettingChanged" Unchecked="SettingChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

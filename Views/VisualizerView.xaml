<UserControl x:Class="MazeRunner.Views.VisualizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MazeRunner.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="282" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="274" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="PARAMETERS" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Margin="0,5,0,0" Text="Maze size" Style="{StaticResource SubheadingTextStyle}" />
                        <TextBlock Margin="0,3,0,10" Text="Logical cells are independent from canvas pixels." Style="{StaticResource MutedTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="WIDTH" Style="{StaticResource MutedTextStyle}" /><TextBox x:Name="WidthTextBox" Margin="0,4,0,0" Text="31" Style="{StaticResource ModernTextBoxStyle}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="HEIGHT" Style="{StaticResource MutedTextStyle}" /><TextBox x:Name="HeightTextBox" Margin="0,4,0,0" Text="21" Style="{StaticResource ModernTextBoxStyle}" /></StackPanel>
                        </Grid>
                        <UniformGrid Margin="0,10,0,0" Columns="4">
                            <Button Margin="0,0,5,0" Padding="3,5" Content="S" Style="{StaticResource ModernButtonStyle}" Click="SmallPresetButton_Click" ToolTip="15 × 11" />
                            <Button Margin="0,0,5,0" Padding="3,5" Content="M" Style="{StaticResource ModernButtonStyle}" Click="MediumPresetButton_Click" ToolTip="31 × 21" />
                            <Button Margin="0,0,5,0" Padding="3,5" Content="L" Style="{StaticResource ModernButtonStyle}" Click="LargePresetButton_Click" ToolTip="61 × 41" />
                            <Button Padding="3,5" Content="XL" Style="{StaticResource ModernButtonStyle}" Click="HugePresetButton_Click" ToolTip="101 × 71" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="GENERATION" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Margin="0,8,0,4" Text="Algorithm" Style="{StaticResource MutedTextStyle}" />
                        <ComboBox x:Name="GeneratorComboBox" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="GeneratorComboBox_SelectionChanged" />
                        <TextBlock Margin="0,12,0,4" Text="Seed" Style="{StaticResource MutedTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="34" /><ColumnDefinition Width="6" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="SeedTextBox" Text="824716" Style="{StaticResource ModernTextBoxStyle}" />
                            <Button Grid.Column="2" Content="↻" Style="{StaticResource IconButtonStyle}" Click="RandomSeedButton_Click" ToolTip="Create a random seed" />
                            <Button Grid.Column="4" Content="⧉" Style="{StaticResource IconButtonStyle}" Click="CopySeedButton_Click" ToolTip="Copy seed" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Braiding / loops" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="LoopsValueLabel" Grid.Column="1" Text="0%" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                        </Grid>
                        <Slider x:Name="LoopsSlider" Margin="0,4,0,0" Minimum="0" Maximum="100" Value="0" TickFrequency="1" Style="{StaticResource ModernSliderStyle}" ValueChanged="LoopsSlider_ValueChanged" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="SOLVER" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Margin="0,8,0,4" Text="Algorithm" Style="{StaticResource MutedTextStyle}" />
                        <ComboBox x:Name="SolverComboBox" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="SolverComboBox_SelectionChanged" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="SelectStartButton" Content="Set start" Style="{StaticResource ModernButtonStyle}" Click="SelectStartButton_Click" />
                            <Button x:Name="SelectGoalButton" Grid.Column="2" Content="Set goal" Style="{StaticResource ModernButtonStyle}" Click="SelectGoalButton_Click" />
                        </Grid>
                        <Button Margin="0,8,0,0" Content="Randomize endpoints" Style="{StaticResource ModernButtonStyle}" Click="RandomizeEndpointsButton_Click" />
                        <CheckBox x:Name="WeightedTerrainCheckBox" Margin="0,12,0,0" Content="Weighted terrain" Style="{StaticResource ModernCheckBoxStyle}" Checked="WeightedTerrainCheckBox_Changed" Unchecked="WeightedTerrainCheckBox_Changed" />
                        <TextBlock Margin="0,5,0,0" Text="Dijkstra and A* optimize movement cost. BFS remains unweighted." Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="0" Grid.Column="2" Padding="0" Style="{StaticResource CardStyle}">
            <Grid>
                <controls:MazeCanvas x:Name="MazeCanvas" ZoomLevelChanged="MazeCanvas_ZoomLevelChanged" CellClicked="MazeCanvas_CellClicked" />
                <Border Margin="12" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource InformationBrush}" VerticalAlignment="Center" /><TextBlock x:Name="CanvasStatusLabel" Margin="7,0,0,0" Text="Ready" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /></StackPanel>
                </Border>
                <Border Margin="12" Padding="5" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="−" Style="{StaticResource IconButtonStyle}" ToolTip="Zoom out" Click="ZoomOutButton_Click" />
                        <TextBlock x:Name="ZoomLabel" Width="54" Text="100%" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextAlignment="Center" VerticalAlignment="Center" />
                        <Button Content="+" Style="{StaticResource IconButtonStyle}" ToolTip="Zoom in" Click="ZoomInButton_Click" />
                        <Button Margin="6,0,0,0" Content="Fit" Style="{StaticResource ModernButtonStyle}" ToolTip="Fit maze to viewport" Click="FitButton_Click" />
                        <Button x:Name="GridToggleButton" Margin="6,0,0,0" Content="Grid on" Style="{StaticResource ModernButtonStyle}" Click="GridToggleButton_Click" />
                    </StackPanel>
                </Border>
                <Border x:Name="ToastBorder" Margin="12,12,12,48" Padding="12,7" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentMutedBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                    <TextBlock x:Name="ToastTextBlock" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                </Border>
                <Border Margin="12" Padding="9,5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <TextBlock Text="Mouse wheel: zoom · Drag: pan · Select start or goal, then click a cell" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="0" Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="LIVE STATISTICS" Style="{StaticResource EyebrowTextStyle}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Status" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="StatusValueLabel" Grid.Column="1" Text="Idle" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="Dimensions" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="DimensionsValueLabel" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="—" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="Cells" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="CellsValueLabel" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="—" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="Generator" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="GeneratorValueLabel" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="—" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Row="4" Margin="0,8,0,0" Text="Solver" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="SolverValueLabel" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="—" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Row="5" Margin="0,8,0,0" Text="Seed" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="SeedValueLabel" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Text="—" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Row="6" Margin="0,8,0,0" Text="Visited" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="VisitedValueLabel" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Text="0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Row="7" Margin="0,8,0,0" Text="Explored" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="ExploredValueLabel" Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" Text="0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Row="8" Margin="0,8,0,0" Text="Frontier" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="FrontierValueLabel" Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" Text="0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Row="9" Margin="0,8,0,0" Text="Path length" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="PathValueLabel" Grid.Row="9" Grid.Column="1" Margin="0,8,0,0" Text="—" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Row="10" Margin="0,8,0,0" Text="Path cost" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="CostValueLabel" Grid.Row="10" Grid.Column="1" Margin="0,8,0,0" Text="—" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Row="11" Margin="0,8,0,0" Text="Elapsed" Style="{StaticResource MutedTextStyle}" /><TextBlock x:Name="ElapsedValueLabel" Grid.Row="11" Grid.Column="1" Margin="0,8,0,0" Text="—" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="ALGORITHM CONTEXT" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock x:Name="AlgorithmNameLabel" Margin="0,8,0,0" Text="Recursive Backtracker" Style="{StaticResource SubheadingTextStyle}" />
                        <TextBlock x:Name="AlgorithmDescriptionLabel" Margin="0,5,0,0" Text="—" Style="{StaticResource MutedTextStyle}" />
                        <Border Margin="0,10,0,0" Style="{StaticResource InsetCardStyle}"><TextBlock x:Name="AlgorithmNotesLabel" Text="—" Style="{StaticResource MutedTextStyle}" /></Border>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="LEGEND" Style="{StaticResource EyebrowTextStyle}" />
                        <UniformGrid Margin="0,9,0,0" Columns="2" Rows="5">
                            <TextBlock Text="■ Wall" Foreground="{DynamicResource MazeWallBrush}" FontSize="11" /><TextBlock Text="■ Frontier" Foreground="{DynamicResource MazeFrontierBrush}" FontSize="11" />
                            <TextBlock Text="■ Explored" Foreground="{DynamicResource MazeExploredBrush}" FontSize="11" /><TextBlock Text="■ Current" Foreground="{DynamicResource MazeCurrentBrush}" FontSize="11" />
                            <TextBlock Text="■ Visited" Foreground="{DynamicResource MazeVisitedBrush}" FontSize="11" /><TextBlock Text="■ Final path" Foreground="{DynamicResource MazeSolutionRouteBrush}" FontSize="11" />
                            <TextBlock Text="■ Start" Foreground="{DynamicResource SuccessBrush}" FontSize="11" /><TextBlock Text="■ Goal" Foreground="{DynamicResource DangerBrush}" FontSize="11" />
                            <TextBlock Text="■ Terrain" Foreground="{DynamicResource WarningBrush}" FontSize="11" /><TextBlock Text="■ Backtrack" Foreground="{DynamicResource MazeBacktrackBrush}" FontSize="11" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.ColumnSpan="5" Margin="0,12,0,0" Padding="12" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="GenerateButton" Content="Generate maze" Style="{StaticResource PrimaryButtonStyle}" ToolTip="Create a new maze from the selected parameters. This does not start the solver." Click="GenerateButton_Click" />
                    <Button x:Name="SolveButton" Margin="7,0,0,0" Content="Solve maze" Style="{StaticResource ModernButtonStyle}" ToolTip="Run the selected pathfinding algorithm on the current maze." Click="SolveButton_Click" />
                    <Button x:Name="PauseButton" Margin="7,0,0,0" Content="Pause" Style="{StaticResource ModernButtonStyle}" Click="PauseButton_Click" />
                    <Button x:Name="StepButton" Margin="7,0,0,0" Content="Step" Style="{StaticResource ModernButtonStyle}" Click="StepButton_Click" />
                    <Button x:Name="ResetSearchButton" Margin="7,0,0,0" Content="Reset search" Style="{StaticResource ModernButtonStyle}" Click="ResetSearchButton_Click" />
                    <Button x:Name="ResetMazeButton" Margin="7,0,0,0" Content="Clear maze" Style="{StaticResource ModernButtonStyle}" Click="ResetMazeButton_Click" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,10,0" Text="Speed" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    <Slider x:Name="SpeedSlider" Width="180" Minimum="1" Maximum="100" Value="62" Style="{StaticResource ModernSliderStyle}" ValueChanged="SpeedSlider_ValueChanged" />
                    <TextBlock x:Name="SpeedValueLabel" Margin="10,0,0,0" Text="62%" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                    <CheckBox x:Name="InstantCheckBox" Margin="14,0,0,0" Content="Instant" Style="{StaticResource ModernCheckBoxStyle}" Checked="InstantCheckBox_Changed" Unchecked="InstantCheckBox_Changed" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Import JSON" Style="{StaticResource ModernButtonStyle}" Click="ImportJsonButton_Click" />
                    <Button Margin="7,0,0,0" Content="Export JSON" Style="{StaticResource ModernButtonStyle}" Click="ExportJsonButton_Click" />
                    <Button Margin="7,0,0,0" Content="Export PNG" Style="{StaticResource ModernButtonStyle}" Click="ExportPngButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
